# Copy this file to .env.local and fill in the values from your Supabase
# project: Dashboard -> Project Settings -> API
#
# .env.local is gitignored, so these never reach GitHub. The same two values
# must also be added in Vercel: Project -> Settings -> Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Newer projects call this the "publishable" key; older ones the "anon" key.
# Either works — it is safe to expose publicly, because row-level security
# in the database is what actually restricts access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
